# Settings for `npm run build:preview` (the single-file preview). No secrets belong here.
VITE_ROUTER=memory

# The preview copy is shared with other people from a Claude artifact (Oisin, 17 Nov), so its
# sign-in page must not print the login. A password hash that is set, even this one, is what
# switches that line off. This is the SHA-256 of "demo": the login is still username demo,
# password demo, until a password of its own is chosen. To change it, run
#   npm run hash-password -- "the new password"
# and paste the result below (and change the username if wanted).
# The hash is not a secret in the way a key is: the same value is inside the published page
# for anyone who can open it. The login is checked in the page itself, so it only keeps out
# people who do not look at the code. Who can open the artifact at all is its Share setting.
VITE_DEMO_USERNAME=demo
VITE_DEMO_PASSWORD_SHA256=2a97516c354b68848cdbd8f54a226a0a55b21ed138e207ad6c5cbb9c00aa5aea
