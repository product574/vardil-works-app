{
  "name": "vardil-construction-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc -p functions --noEmit && vite build",
    "build:cloudflare": "cross-env VITE_LOGIN=access npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p functions --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "hash-password": "node scripts/hash-password.mjs",
    "build:preview": "vite build --mode preview",
    "build:local": "cross-env ALLOW_DEFAULT_LOGIN=1 npm run build",
    "build:access-test": "cross-env VITE_LOGIN=access vite build --outDir dist-access"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "clsx": "^2.1.1",
    "immer": "^11.2.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
